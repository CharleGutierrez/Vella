{
  "name": "vella-vscode",
  "displayName": "Vella",
  "description": "VS Code Extension for the Vella framework",
  "version": "0.0.1",
  "publisher": "vella",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vella.syncSdk",
        "title": "Vella: Sync SDK"
      },
      {
        "command": "vella.generateWallet",
        "title": "Vella: Generate Wallet"
      },
      {
        "command": "vella.openSchemaBuilder",
        "title": "Vella: Open Visual Schema Builder"
      },
      {
        "command": "vella.scaffoldReact",
        "title": "Vella: Scaffold React Boilerplate"
      },
      {
        "command": "vella.scaffoldVue",
        "title": "Vella: Scaffold Vue Boilerplate"
      },
      {
        "command": "vella.scaffoldAngular",
        "title": "Vella: Scaffold Angular Boilerplate"
      },
      {
        "command": "vella.scaffoldErpSchemas",
        "title": "Vella: Scaffold ERP Schemas"
      },
      {
        "command": "vella.scaffoldDoubleEntryLedger",
        "title": "Vella: Scaffold Double-Entry Ledger Logic"
      },
      {
        "command": "vella.scaffoldLimitOrderBook",
        "title": "Vella: Scaffold Limit Order Book"
      },
      {
        "command": "vella.scaffoldTradingStrategy",
        "title": "Vella: Scaffold Quantitative Trading Strategy"
      },
      {
        "command": "vella.scaffoldSmartContractDeployer",
        "title": "Vella: Scaffold Smart Contract Deployer"
      },
      {
        "command": "vella.scaffoldWalletGenerator",
        "title": "Vella: Scaffold Web3 Wallet Generator"
      },
      {
        "command": "vella.scaffoldUdpTelemetry",
        "title": "Vella: Scaffold UDP Telemetry Ingestion"
      },
      {
        "command": "vella.scaffoldScadaStateMachine",
        "title": "Vella: Scaffold SCADA State Machine"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^18.x",
    "typescript": "^5.1.3"
  }
}
